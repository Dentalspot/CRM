# ============================================================
# DentalSpot — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env with real values
# ============================================================

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Meta Pixel (Facebook/Instagram ads tracking)
VITE_META_PIXEL_PATIENTS=your-pixel-id
VITE_META_PIXEL_PROFESSIONALS=your-pixel-id
VITE_META_AD_ACCOUNT_ID=act_your-account-id

# Sentry — error tracking (público, se incluye en bundle JS)
# Crear proyecto React en sentry.io → Settings → Client Keys (DSN)
# Si vacío, Sentry queda no-op (útil para dev local sin ruido).
VITE_SENTRY_DSN=https://xxx@xxx.ingest.us.sentry.io/xxx
VITE_SENTRY_ENVIRONMENT=development

# Google Analytics 4 — page views + custom events landings
# Crear propiedad GA4 en analytics.google.com → Admin → Streams → Web → copiar Measurement ID
# Formato: G-XXXXXXXXXX. Si vacío, GA4 queda no-op (no se carga gtag.js).
# Respeta el sistema de consent existente (categoría "analytics" del banner de cookies).
# NO commitear valor real — config en Hostinger hPanel.
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
